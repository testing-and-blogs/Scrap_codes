# -----------------------------------------------------------------------------
# Example Environment Variables
#
# Copy this file to .env and fill in the values for your local development.
# Do NOT commit the .env file to version control.
# -----------------------------------------------------------------------------

# -- Django Core Settings --
# WARNING: This is an insecure default secret key.
# Generate a new one for production environments.
DJANGO_SECRET_KEY=django-insecure-default-key-for-development-only

# Set to False in production
DJANGO_DEBUG=True

# -- PostgreSQL Database --
# These are the credentials for the application's own database.
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=app_password
DB_HOST=db
DB_PORT=5432

# -- Redis (for Celery Task Queue) --
REDIS_HOST=redis
REDIS_PORT=6379

# -- Fernet Encryption Key --
# Used for encrypting and decrypting database connection credentials.
# Generate a new key for production using the following command:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DMIGRATE_FERNET_KEY=TSVEoB3S10C0mBmsA2IhLIPcoWIw9YD8qwnkVlWPLM8=
